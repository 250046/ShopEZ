<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" prefWidth="900" prefHeight="650"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shopez.controller.RegisterController"
      styleClass="login-container">

    <padding><Insets top="20" right="40" bottom="20" left="40"/></padding>

    <VBox alignment="CENTER" spacing="12" maxWidth="450" styleClass="card">
        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <Label text="Create Account" styleClass="app-title"/>

        <VBox spacing="3">
            <Label text="Full Name"/>
            <TextField fx:id="nameField" promptText="Enter your full name"/>
            <Label fx:id="nameError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>

        <VBox spacing="3">
            <Label text="Email"/>
            <TextField fx:id="emailField" promptText="Enter your email"/>
            <Label fx:id="emailError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>

        <VBox spacing="3">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Enter password"/>
            <Label fx:id="passwordError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>

        <VBox spacing="3">
            <Label text="Confirm Password"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm password"/>
            <Label fx:id="confirmError" styleClass="error-label" visible="false" managed="false"/>
        </VBox>

        <VBox spacing="3">
            <Label text="Account Type"/>
            <ComboBox fx:id="roleCombo" promptText="Select role" maxWidth="Infinity"/>
        </VBox>

        <VBox fx:id="storeNameBox" spacing="3" visible="false" managed="false">
            <Label text="Store Name"/>
            <TextField fx:id="storeNameField" promptText="Enter your store name"/>
        </VBox>

        <Button text="Register" onAction="#handleRegister" styleClass="primary-button" maxWidth="Infinity"/>

        <Hyperlink text="Already have an account? Sign in" onAction="#handleLoginLink" styleClass="link"/>
    </VBox>
</VBox>
