<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.shopez.controller.ProductListController">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <VBox spacing="5">
        <Label text="Our Products" styleClass="page-title"/>
        <Label text="Browse our complete collection of premium items" styleClass="page-subtitle"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="🔍  Search products..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
        <Button text="Search" onAction="#handleSearch" styleClass="primary-button"/>
        <ComboBox fx:id="categoryCombo" promptText="All Categories" onAction="#handleCategoryFilter" prefWidth="160"/>
        <Button text="Clear" onAction="#handleClearFilter" styleClass="secondary-button"/>
    </HBox>

    <Label fx:id="resultCountLabel" text="" styleClass="text-secondary"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="products-scroll">
        <FlowPane fx:id="productsPane" hgap="15" vgap="15" prefWrapLength="860">
            <padding><Insets top="5" right="5" bottom="5" left="5"/></padding>
        </FlowPane>
    </ScrollPane>
</VBox>
